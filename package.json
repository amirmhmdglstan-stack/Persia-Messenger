{
  "name": "persia-messenger",
  "version": "5.0.0",
  "description": "Persia Messenger - گپ گروهی لوکس با قابلیت تبدیل به APK",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:pwa": "pwa2apk --input ./public --output ./apk --name 'Persia Messenger' --version 5.0.0",
    "build:android": "npx cap copy && npx cap open android"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "multer": "1.4.5-lts.1",
    "socket.io": "^4.7.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "nodemon": "^3.0.1"
  }
}
